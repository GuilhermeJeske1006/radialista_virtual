NEXT_PUBLIC_API_URL=http://localhost:8000

# Chave publicavel do Stripe (dashboard.stripe.com/apikeys) -- usada pelo checkout
# transparente (embedded) no navegador. Nao e' segredo, mas precisa bater com a conta
# Stripe do STRIPE_SECRET_KEY do backend.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Monitoramento de erros (sentry.io) -- deixe vazio pra desativar (padrao em dev local).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
