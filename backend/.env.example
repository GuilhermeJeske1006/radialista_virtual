# Chave da API Claude (Anthropic)
ANTHROPIC_API_KEY=

# URL base do WuzAPI. Ao rodar via docker-compose, esse valor e sobrescrito
# automaticamente para http://host.docker.internal:8080 -- so importa para uso local (uvicorn direto).
WUZAPI_BASE_URL=http://localhost:8080

# Token do usuario WuzAPI criado para a radio de teste (usado pelo seed inicial, ver app/db/seed.py)
WUZAPI_USER_TOKEN=

# Nome do locutor virtual (usado pelo seed inicial)
LOCUTOR_NOME=Ze do Radio

# Token admin do WuzAPI (mesmo valor de WUZAPI_ADMIN_TOKEN em wuzapi/.env) -- usado pelo
# onboarding automatizado (app/onboarding/router.py) para criar um usuario novo por radio.
WUZAPI_ADMIN_TOKEN=

# URL que o WuzAPI vai chamar ao criar um novo usuario via onboarding. Ao rodar via
# docker-compose local, use http://host.docker.internal:8000/webhook/whatsapp.
WUZAPI_WEBHOOK_URL=http://host.docker.internal:8000/webhook/whatsapp

# Segredo usado para assinar os tokens JWT do painel -- gere com: openssl rand -hex 32
JWT_SECRET=

# URL do painel (Next.js), usada para CORS e para os redirects do Stripe Checkout
FRONTEND_URL=http://localhost:3001

# Origens extras liberadas no CORS, separadas por virgula (ex.: tunel ngrok em dev)
CORS_EXTRA_ORIGINS=

# Chaves do Stripe (modo teste durante desenvolvimento) -- dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Chave da YouTube Data API v3 (console.cloud.google.com), usada para buscar as musicas
# tocadas no bloco "musica" do programa ao vivo (app/live/music.py)
YOUTUBE_API_KEY=

# Credenciais de app da Spotify Web API (developer.spotify.com/dashboard), Client Credentials
# Flow -- usadas so' pra descobrir faixas oficiais por genero (app/live/spotify.py), nao pra
# tocar audio. Deixe vazio para desativar (fluxo cai pra sugestao via LLM).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Chave da API ElevenLabs (elevenlabs.io/app/settings/api-keys) e ID da voz escolhida
# (elevenlabs.io/app/voice-library). Deixe vazio para desativar audio -- so texto e enviado.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Diretorio onde ficam os arquivos enviados pelo usuario (ex.: audio de patrocinadores)
# quando STORAGE_BACKEND=local.
UPLOAD_DIR=uploads

# Backend de armazenamento dos arquivos enviados: "local" (disco, dev) ou "s3" (AWS, producao).
# Com s3, configure AWS_S3_BUCKET (e AWS_REGION se nao for us-east-1). Credenciais da AWS vao
# em AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY (padrao do boto3) ou via IAM role -- nao tem
# variavel propria aqui de proposito, pra nao duplicar segredo fora do padrao da AWS.
STORAGE_BACKEND=local
AWS_S3_BUCKET=
AWS_REGION=us-east-1
# So preencher pra testar contra LocalStack/MinIO em vez da AWS de verdade.
AWS_S3_ENDPOINT_URL=

# Envio de e-mail (redefinicao de senha, convites) via Resend (resend.com) -- deixe
# SMTP_HOST vazio para so logar o link no console em vez de enviar (dev local sem SMTP).
# SMTP_USER e sempre a string literal "resend"; SMTP_PASSWORD e a API key (re_xxx) gerada
# em resend.com/api-keys. SMTP_FROM precisa ser de um dominio verificado em resend.com/domains,
# ou use onboarding@resend.dev para testar (so entrega para o proprio email da conta Resend).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=Radialista Virtual <no-reply@radialista.app>

# Senha do Postgres da aplicacao (config/guardrails) -- distinto do banco interno do WuzAPI
# gere com: openssl rand -hex 16
APP_DB_PASSWORD=

# URLs usadas apenas em desenvolvimento local sem docker-compose (uvicorn direto)
DATABASE_URL=postgresql://radialista:radialista@localhost:5433/radialista
REDIS_URL=redis://localhost:6379/0

# Monitoramento de erros (sentry.io/settings/.../projects/.../keys) -- deixe vazio
# pra desativar (comportamento padrao em dev local).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
