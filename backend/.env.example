# Chave da API Claude (Anthropic)
ANTHROPIC_API_KEY=

# URL base do WuzAPI. Ao rodar via docker-compose, esse valor e sobrescrito
# automaticamente para http://host.docker.internal:8080 -- so importa para uso local (uvicorn direto).
WUZAPI_BASE_URL=http://localhost:8080

# Token do usuario WuzAPI criado para a radio de teste (usado pelo seed inicial, ver app/db/seed.py)
WUZAPI_USER_TOKEN=

# Nome do locutor virtual (usado pelo seed inicial)
LOCUTOR_NOME=Ze do Radio

# Token admin do WuzAPI (mesmo valor de WUZAPI_ADMIN_TOKEN em wuzapi/.env) -- usado pelo
# onboarding automatizado (app/onboarding/router.py) para criar um usuario novo por radio.
WUZAPI_ADMIN_TOKEN=

# URL que o WuzAPI vai chamar ao criar um novo usuario via onboarding. Ao rodar via
# docker-compose local, use http://host.docker.internal:8000/webhook/whatsapp.
WUZAPI_WEBHOOK_URL=http://host.docker.internal:8000/webhook/whatsapp

# Segredo usado para assinar os tokens JWT do painel -- gere com: openssl rand -hex 32
JWT_SECRET=

# URL do painel (Next.js), usada para CORS e para os redirects do Stripe Checkout
FRONTEND_URL=http://localhost:3000

# Chaves do Stripe (modo teste durante desenvolvimento) -- dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Chave da YouTube Data API v3 (console.cloud.google.com), usada para buscar as musicas
# tocadas no bloco "musica" do programa ao vivo (app/live/music.py)
YOUTUBE_API_KEY=

# Chave da API ElevenLabs (elevenlabs.io/app/settings/api-keys) e ID da voz escolhida
# (elevenlabs.io/app/voice-library). Deixe vazio para desativar audio -- so texto e enviado.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Diretorio onde ficam os arquivos enviados pelo usuario (ex.: audio de patrocinadores).
# Em producao, aponte pra um volume persistente montado no container do backend.
UPLOAD_DIR=uploads

# Envio de e-mail (redefinicao de senha) -- deixe SMTP_HOST vazio para so logar o link
# no console em vez de enviar (uso em dev local sem SMTP configurado).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Radialista Virtual <no-reply@radialista.app>

# Senha do Postgres da aplicacao (config/guardrails) -- distinto do banco interno do WuzAPI
# gere com: openssl rand -hex 16
APP_DB_PASSWORD=

# URLs usadas apenas em desenvolvimento local sem docker-compose (uvicorn direto)
DATABASE_URL=postgresql://radialista:radialista@localhost:5433/radialista
REDIS_URL=redis://localhost:6379/0
