# Token admin usado para criar usuarios via /admin/users no WuzAPI
WUZAPI_ADMIN_TOKEN=troque-por-um-token-forte

# Senha do Postgres interno do WuzAPI
WUZAPI_DB_PASSWORD=troque-por-uma-senha-forte

# URL do backend que recebera os webhooks do WuzAPI (ajuste host/porta)
WUZAPI_GLOBAL_WEBHOOK=http://host.docker.internal:8000/webhook/whatsapp

WEBHOOK_FORMAT=json

# Chaves fixas para persistir sessao/dados criptografados entre restarts
# (gere com: openssl rand -hex 16)
WUZAPI_GLOBAL_ENCRYPTION_KEY=
WUZAPI_GLOBAL_HMAC_KEY=
